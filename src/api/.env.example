# Copy to .env for local dev (all values are dummies — real secrets go in the VPS env).
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kivlo
CORS_ORIGINS=http://localhost:3000,https://itswafflezlol.github.io
LOG_LEVEL=info

# Local dev auth: accepts `Authorization: Bearer dev` for the seeded user. Never in prod.
DEV_AUTH=1
DEV_USER_ID=00000000-0000-0000-0000-0000000000a1

# Supabase (prod): JWKS preferred; HS256 secret for self-hosted.
SUPABASE_URL=https://example.supabase.co
SUPABASE_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=dummy-jwt-secret-change-me

# Cloudflare R2 (presigned uploads)
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_BUCKET=kivlo-dev
R2_ACCESS_KEY_ID=dummy
R2_SECRET_ACCESS_KEY=dummy
R2_PUBLIC_BASE=https://files.example.com
